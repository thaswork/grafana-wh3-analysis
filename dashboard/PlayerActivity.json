          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH activity AS (\n    SELECT\n        \"ActivityDate\",\n        \"HighPlayerCount\",\n        \"LowPlayerCount\",\n        ( \"HighPlayerCount\" + \"LowPlayerCount\" ) / 2.0 AS \"DailyMidpoint\"\n    FROM \"PlayerActivity\"\n),\nrolling AS (\n    SELECT\n        \"ActivityDate\",\n        \"HighPlayerCount\",\n        \"LowPlayerCount\",\n        AVG ( \"DailyMidpoint\" ) OVER (\n            ORDER BY \"ActivityDate\"\n            ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n        ) AS \"AverageDailyMidpoint7D\",\n        AVG ( \"DailyMidpoint\" ) OVER (\n            ORDER BY \"ActivityDate\"\n            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW\n        ) AS \"AverageDailyMidpoint30D\"\n    FROM activity\n)\nSELECT\n    \"ActivityDate\" AS \"time\",\n    \"HighPlayerCount\",\n    \"LowPlayerCount\",\n    \"AverageDailyMidpoint7D\",\n    \"AverageDailyMidpoint30D\"\nFROM rolling\nWHERE $__timeFilter(\"ActivityDate\")\nORDER BY \"ActivityDate\";",
          "refId": "A",
          "sql": {
