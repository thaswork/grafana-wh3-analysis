                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH activity AS (\n    SELECT\n        \"Date\",\n        \"High\",\n        \"Low\",\n        ( \"High\" + \"Low\" ) / 2.0 AS \"DailyMidpoint\"\n    FROM \"PlayerActivity\"\n),\nrolling AS (\n    SELECT\n        \"Date\",\n        \"High\",\n        \"Low\",\n        AVG ( \"DailyMidpoint\" ) OVER (\n            ORDER BY \"Date\"\n            ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n        ) AS \"AverageDailyMidpoint7D\",\n        AVG ( \"DailyMidpoint\" ) OVER (\n            ORDER BY \"Date\"\n            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW\n        ) AS \"AverageDailyMidpoint30D\"\n    FROM activity\n)\nSELECT\n    \"Date\" AS \"time\",\n    \"High\",\n    \"Low\",\n    \"AverageDailyMidpoint7D\",\n    \"AverageDailyMidpoint30D\",\n    0.0::double precision AS \"BuildAnnouncementsLegend\",\n    0.0::double precision AS \"DiscountEventsLegend\"\nFROM rolling\nWHERE $__timeFilter(\"Date\")\nORDER BY \"Date\";",
