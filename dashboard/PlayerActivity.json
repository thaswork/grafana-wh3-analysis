            "spec": {
              "dataset": "wh3_analysis",
              "editorMode": "code",
              "format": "time_series",
              "rawQuery": true,
              "rawSql": "SELECT\n    \"Timestamp\" AS \"time\",\n    \"PatchTitle\" AS \"text\",\n    CONCAT_WS (\n        ', ',\n        CASE WHEN \"IsPatch\" THEN 'Patch' END,\n        CASE WHEN \"IsHotfix\" THEN 'Hotfix' END,\n        CASE WHEN \"IsFreeContent\" THEN 'Free Content' END,\n        CASE WHEN \"IsPaidContent\" THEN 'Paid Content' END\n    ) AS \"tags\"\nFROM \"Build\"\nWHERE $__timeFilter(\"Timestamp\")\n    AND (\n        \"IsPatch\"\n        OR \"IsHotfix\"\n        OR \"IsFreeContent\"\n        OR \"IsPaidContent\"\n    )\nORDER BY \"Timestamp\";",
              "refId": "Anno",
              "sql": {
                "columns": [
                  {
                    "parameters": [],
                    "type": "function"
                  }
                ],
                "groupBy": [
                  {
